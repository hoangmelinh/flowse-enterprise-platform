# ==============================================================================
# FLOWSE ENTERPRISE PLATFORM (FLOWSE 2.0) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Service
BACKEND_PORT=5001
FRONTEND_PORT=5173
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=flowse_enterprise
DB_SSL=false

# Cache & Messaging
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication & Security
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_min_64_chars_long_123456789
EMAIL_TOKEN_SECRET=your_super_secret_email_token_key_min_64_chars_long_123456789
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# AI Integration (Groq Llama 3.3)
GROQ_API_KEY=your_groq_api_key

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key
